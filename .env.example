# Copy to .env and fill in. Never commit .env.
ALLO_ENV=dev

# PRIM: prim.iledefrance-mobilites.fr > Mon compte > API key
ALLO_PRIM_API_KEY=

# Twilio: Console > Account info > Auth Token (used to verify webhook signatures)
ALLO_TWILIO_AUTH_TOKEN=
# Your public URL, exactly as configured in Twilio (no trailing slash)
ALLO_PUBLIC_BASE_URL=https://your-domain.ngrok-free.app
ALLO_VERIFY_TWILIO_SIGNATURE=true

# Shown on the web page, e.g. +33 1 23 45 67 89 (empty hides it)
ALLO_PUBLIC_PHONE=

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
ALLO_CALLER_HMAC_KEY=

ALLO_DAILY_CALL_CAP=200
ALLO_PER_CALLER_CALLS_PER_DAY=10
ALLO_MAX_CALL_SECONDS=180
ALLO_TRANSCRIPT_RETENTION_DAYS=30
ALLO_REALTIME_STALE_AFTER_SECONDS=120
ALLO_CACHE_TTL_SECONDS=30
# Stay under the PRIM account quota (shared by phone + web)
ALLO_PRIM_DAILY_BUDGET=900
ALLO_WEB_REQUESTS_PER_MINUTE=20

# Optional Twilio voices, e.g. Polly.Lea-Neural / Polly.Amy-Neural (leave empty for default)
ALLO_TTS_VOICE_FR=
ALLO_TTS_VOICE_EN=

# ---- AI agent (optional). Without a key, the rules-only path is used. ----
# anthropic or openai
ALLO_LLM_PROVIDER=
ALLO_LLM_API_KEY=
# Leave empty for the default (claude-haiku-4-5 / gpt-4.1-mini); check the provider's model list
ALLO_LLM_MODEL=
# Hard daily cap in USD; when reached, the service falls back to rules only
ALLO_LLM_DAILY_BUDGET_USD=1.0
# USD per million tokens; leave empty for rough defaults, check the provider pricing page
ALLO_LLM_PRICE_IN=
ALLO_LLM_PRICE_OUT=

# ---- Journey planner (IDFM PRIM Navitia). Check with: python scripts/check_routes.py ----
ALLO_NAVITIA_URL=https://prim.iledefrance-mobilites.fr/marketplace/v2/navitia/journeys
ALLO_ROUTE_DAILY_BUDGET=300

# ---- EV chargers (Belib'). Reliability flags published by the collector on the ev-data branch ----
# Leave empty for the default (this repo's ev-data branch)
ALLO_EV_FLAGS_URL=

